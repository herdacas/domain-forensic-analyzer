[run]
source = src
omit =
    src/core/result_formatter.py
    src/core/cli.py
    */test_*
    */__pycache__/*
    audit_modules.py
    run.py
    validate_export.py

[report]
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    except ImportError:
    LOGURU_AVAILABLE = False
    CORE_MODULES_AVAILABLE = False
